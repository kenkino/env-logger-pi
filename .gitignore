# --- Python関連 ---
__pycache__/
*.py[cod]
*$py.class

# --- 仮想環境 ---
venv/
env/
.env

# --- OS・エディタ関連 ---
.DS_Store          # macOSで生成される隠しファイル
.vscode/           # VSCodeの設定フォルダ
.idea/             # PyCharmの設定フォルダ

# --- ログ・生成物 ---
logs/*.log
service/env_logger.service # 自動生成用
config.json               # 環境ごとの設定（機密情報を含む場合）
